# OpenRouter API key (get one free at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Comma-separated OpenRouter model id(s), used as primary + fallbacks.
# Free models rotate frequently — check current free options at:
# https://openrouter.ai/models?max_price=0
# Example: OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free,qwen/qwen3-235b-a22b:free
OPENROUTER_MODEL=

# Optional: port for the local API server (defaults to 8787)
PORT=8787
